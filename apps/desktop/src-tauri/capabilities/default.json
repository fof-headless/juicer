{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the Juicer main window",
  "windows": ["main", "*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$TEMP/**" },
        { "path": "$HOME/**" },
        { "path": "/tmp/**" }
      ]
    }
  ]
}
